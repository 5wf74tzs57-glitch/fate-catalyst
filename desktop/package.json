{
  "name": "fate-catalyst",
  "productName": "Catalyst",
  "version": "0.3.0",
  "description": "A low-poly 3D trickster sandbox.",
  "author": "Catalyst",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:web": "node build-offline.mjs",
    "build:win": "node build-offline.mjs && electron-packager . \"Catalyst\" --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"^/dist\" --ignore=\"^/node_modules\" --ignore=\"^/build-offline.mjs\" --ignore=\"^/src\" --app-version=0.3.0 --win32metadata.ProductName=\"Catalyst\" --win32metadata.FileDescription=\"Catalyst\""
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "cannon-es": "0.20.0",
    "electron": "33.2.1",
    "esbuild": "0.24.0",
    "three": "0.160.0"
  }
}
